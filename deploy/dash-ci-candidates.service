[Unit]
Description=Bounded Platform PR image candidate runner launcher
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0077
WorkingDirectory=/opt/dash-selfhosted-image
ExecStart=/usr/bin/python3 /opt/dash-selfhosted-image/scripts/candidate_runner.py --config /etc/dash-ci-candidates/config.json --apply
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dash-ci-candidates
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
